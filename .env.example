# Analog Racing Club — environment for the Docker Compose stack.
# Copy to `.env` on the host and fill in. `.env` is gitignored; never commit secrets.
# docker compose reads `.env` automatically from the project directory.

# Published host port; Caddy reverse-proxies analogracingclub.com -> this port.
APP_PORT=8004

# MongoDB database name (defaults to `arc` when unset).
# MONGO_DB=arc

# --- Admin login (/admin) ---
# Required in production. When empty, the admin area is loopback-only (dev mode).
ADMIN_PASSWORD=

# Signs the admin session cookie. Generate with:  openssl rand -hex 32
# When empty a random secret is generated at boot, so a restart logs you out.
SESSION_SECRET=
