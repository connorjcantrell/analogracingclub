# Analog Racing Club — environment for the Docker Compose stack.
# Copy to `.env` on the host and fill in. `.env` is gitignored; never commit secrets.
# docker compose reads `.env` automatically from the project directory.

# Published host port; Caddy reverse-proxies analogracingclub.com -> this port.
APP_PORT=8004

# Public origin of the site (SvelteKit checks it on form posts, e.g. admin login).
# ORIGIN=https://analogracingclub.com

# MongoDB database name (defaults to `arc` when unset).
# MONGO_DB=arc

# --- Admin auth (/admin, /api/admin/*) ---
# Option A (production, same as league): Cloudflare Access. Login happens at the
# edge via the Zero Trust identity provider (GitHub); the app verifies the token.
# Zero Trust -> Access -> Applications -> the analogracingclub.com app -> Audience tag.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Option B: password form. Used only when the CF_ACCESS_* pair above is empty.
# With all three empty the admin area is loopback-only (dev mode).
ADMIN_PASSWORD=

# Signs the password-login session cookie (unused under Access). Generate with:  openssl rand -hex 32
# When empty a random secret is generated at boot, so a restart logs you out.
SESSION_SECRET=
